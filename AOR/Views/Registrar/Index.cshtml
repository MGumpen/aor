@model AOR.Models.View.RegistrarIndexViewModel
@using Microsoft.AspNetCore.Identity
@inject UserManager<AOR.Models.Data.UserModel> UserManager

@{
    var currentUser = await UserManager.GetUserAsync(User);
    Layout = "_Layout";
    ViewData["Title"] = "Registrar - Dashboard";
}

<link rel="stylesheet" href="~/css/Registrar/Index.css" />


<section class="container align-content-center">

<div class="admin-wrapper">
    <h2>Welcome, @($"{currentUser?.FirstName} {currentUser?.LastName}")</h2>

    <div class="admin-grid">
        <a class="admin-tile" asp-action="AllReports">All reports @{
            if (Model.UnassignedPendingCount > 0)
            {
                <text> <span class="badge badge-orange ms-2">@Model.UnassignedPendingCount Unassigned</span></text>
            }
        }</a>
        <a class="admin-tile" asp-action="AssignedReports">Assigned reports @if(Model.AssignedPendingCount > 0) { <span class="badge badge-orange ms-2">@Model.AssignedPendingCount Pending</span> }</a>
    </div>
</div>

</section>

<script>
    document.addEventListener('DOMContentLoaded', function(){
        var first = document.querySelector('.admin-tile');
        if(first) first.setAttribute('tabindex','0');
    });
</script>
